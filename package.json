{
  "name": "money-rooms",
  "version": "2.0.0",
  "private": true,
  "description": "Free, comprehensive financial planning software from Stress Less About Money.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tie-out": "vite-node tests/tie-out/print-maya.ts",
    "tie-out:compare": "vite-node tests/tie-out/compare-maya.ts",
    "tie-out:m2": "vite-node tests/tie-out/compare-maya-m2.ts",
    "app:test": "vitest run -c app/vitest.config.ts",
    "app:typecheck": "tsc --noEmit -p app",
    "app:dev": "vite -c app/vite.config.ts",
    "app:build": "tsc --noEmit -p app && vite build -c app/vite.config.ts",
    "app:check-clients": "node scripts/check-no-client-files.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
